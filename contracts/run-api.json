{
  "schemaVersion": 1,
  "source": "evilsysadmin/chess-studio/frontend/src/chronicles/chroniclesRunClient.js",
  "routes": [
    {
      "method": "POST",
      "path": "/api/chronicles/runs",
      "auth": true,
      "body": "mapId optional",
      "headers": [
        "Idempotency-Key",
        "X-Chronicles-Party-Level"
      ]
    },
    {
      "method": "GET",
      "path": "/api/chronicles/runs",
      "auth": true,
      "response": "runs array"
    },
    {
      "method": "GET",
      "path": "/api/chronicles/runs/{runId}/bootstrap",
      "auth": true
    },
    {
      "method": "DELETE",
      "path": "/api/chronicles/runs/{runId}",
      "auth": true,
      "successStatus": 204
    },
    {
      "method": "PUT",
      "path": "/api/chronicles/runs/{runId}/checkpoint",
      "auth": true,
      "body": "checkpoint"
    }
  ],
  "requirements": [
    "owner-scoped run inventory",
    "no recreation of deleted or foreign run",
    "checkpoint worldVersion concurrency",
    "preserve Idempotency-Key semantics",
    "do not change save format during extraction"
  ]
}
